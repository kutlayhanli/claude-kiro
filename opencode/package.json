{
  "name": "opencode-claude-kiro",
  "version": "0.11.0",
  "description": "claude-kiro spec-driven development for OpenCode: /spec commands, role agents, spec workflows and guard hooks. Needs the `ck` CLI.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Kutlay Hanli"
  },
  "homepage": "https://github.com/kutlayhanli/claude-kiro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kutlayhanli/claude-kiro.git",
    "directory": "opencode"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "claude-kiro",
    "spec-driven-development",
    "kiro",
    "workflows",
    "tdd"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "src",
    "vendor",
    "scripts/arm.mjs",
    "scripts/bench-probe.mjs",
    "scripts/preflight.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync-vendor": "node scripts/sync-vendor.ts",
    "vendor:check": "node scripts/sync-vendor.ts --check",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "node scripts/sync-vendor.ts",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "@opencode/theme": "2.2.3",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "solid-js": "1.9.17"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  }
}
